# DChain Environment Configuration Template
# Copy this to .env.dchain and fill in your actual DChain values

# Server
PORT=3001
NODE_ENV=production

# Database Configuration
DB_HOST=your_dchain_db_host
DB_PORT=5544
DB_NAME=blockchain
DB_USER=your_dchain_db_user
DB_PASSWORD=your_dchain_db_password_change_this_in_production

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Blockchain - DChain Configuration
BLOCKCHAIN_RPC_URL=https://mainnet.dchain.id/
BLOCKCHAIN_CHAIN_ID=17845
CONTRACT_ADDRESS=                                     # Fill after deploying to DChain
DEPLOYER_ADDRESS=0xYourDeployerAddressHere
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_change_this_in_production

# Optional: Add DChain API key if required
# DCHAIN_API_KEY=your_api_key_here

# CORS
CORS_ORIGIN=http://localhost:3000

# Gas Configuration (optional - for gas optimization)
MAX_GAS_PRICE=1000000000                              # Max gas price in wei (1 Gwei)
GAS_LIMIT_MULTIPLIER=1.2                              # Multiply estimated gas by this

# Notes:
# 1. Get DChain RPC URL from: [Add DChain docs URL]
# 2. Get DChain Chain ID from: [Add DChain network info URL]
# 3. Ensure your deployer address has sufficient DChain tokens for gas
# 4. After deploying contract, update CONTRACT_ADDRESS
